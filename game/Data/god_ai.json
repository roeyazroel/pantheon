{
  // The gods' strategic utility AI (spec sections 47-48 and 87, ADR-011). Every EvaluationIntervalTicks
  // ticks (30 = 3 s at x1) each AI god scores every miracle it may cast on every settlement, sending its
  // Creature, and waiting (Patience), and takes the best. Values are weighted by its personality's profile.
  "EvaluationIntervalTicks": 30,
  "Patience": 0.12,
  "DecisionJitter": 0.05,
  "ReferencePopulation": 100.0,
  "CreatureSendDistance": 250.0,

  // Rain (ADR-013) is worth calling only where the farmland's drought (settlement_rules.json) is past
  // RainDrought; its value grows from there to parched land.
  "RainDrought": 0.3,

  // A god's temper (ADR-065) leans from its personality's profile, each leaning from -1 to 1: a leaning
  // of 1 adds TemperReach to the profile's Aggression, Cooperation, Treachery, Grudge, Protect, Convert
  // or Intimidate, -1 takes it away. Gods made before tempers, and players' gods, lean nowhere.
  "TemperReach": 0.15,

  // How gods keep watch over the villages they lead (ADR-070). Every IntervalTicks a god looks for another
  // god's Creature within Radius metres of one, and answers by its hostility to that god (its standing
  // with it, its view of it and its appetite for war, 0..1): up to WelcomeHostility it welcomes the
  // visitor, its Creature coming to greet it; from RepelHostility it drives it out, setting its Creature
  // on it when at least RepelConfidence sure of it; between, it watches, its Creature following the
  // visitor. It remembers a visit, and tells of it, once in CooldownSeconds.
  "Watch": { "Radius": 220.0, "IntervalTicks": 10, "CooldownSeconds": 60.0, "RepelHostility": 0.75, "WelcomeHostility": 0.25, "RepelConfidence": 0.4 },

  // Protect: help own followers in need. Convert: win others with kind miracles. Intimidate: frighten,
  // rivals' followers first. Bless: bless the land. Opportunism: extra appeal of targets in hardship or
  // doubt. Thrift: utility falls by Thrift x cost / power. SendCreature: send the Creature to court a
  // settlement. CreatureKindness: what it teaches its Creature (-1 rewards cruelty, 1 rewards kindness).
  // Diplomacy (ADR-012): Cooperation (alliances and peace), Aggression (war), Treachery (breaking an
  // alliance when it pays, and going alone near a joint victory, ADR-015) and Grudge (how heavily it
  // weighs what others did to it). RefugeePolicy (ADR-016): what it does with migrants arriving where it
  // is followed most: Welcome, DemandConversion or TurnAway (migration.json). HolySites (ADR-021): sending
  // its Creature to claim holy sites and hold its own. Domains: the domains it takes up, in order.
  "Profiles": [
    { "Personality": "Guardian", "Protect": 1.0, "Convert": 0.35, "Intimidate": 0.0, "Bless": 0.5, "Opportunism": 0.2, "Thrift": 0.5, "SendCreature": 0.4, "CreatureKindness": 1.0, "Cooperation": 0.8, "Aggression": 0.2, "Treachery": 0.1, "Grudge": 0.5, "RefugeePolicy": "Welcome", "HolySites": 0.4, "Domains": ["Life", "Protection", "Prosperity"] },
    { "Personality": "Tyrant", "Protect": 0.3, "Convert": 0.3, "Intimidate": 0.8, "Bless": 0.1, "Opportunism": 0.5, "Thrift": 0.5, "SendCreature": 0.5, "CreatureKindness": -0.8, "Cooperation": 0.25, "Aggression": 0.9, "Treachery": 0.5, "Grudge": 0.9, "RefugeePolicy": "DemandConversion", "HolySites": 0.5, "Domains": ["Death", "Storm", "Chaos"] },
    { "Personality": "Opportunist", "Protect": 0.5, "Convert": 0.8, "Intimidate": 0.4, "Bless": 0.3, "Opportunism": 1.0, "Thrift": 0.6, "SendCreature": 0.5, "CreatureKindness": 0.0, "Cooperation": 0.5, "Aggression": 0.5, "Treachery": 0.9, "Grudge": 0.3, "RefugeePolicy": "Welcome", "HolySites": 0.6, "Domains": ["Trickery", "Prosperity", "Fire"] },
    { "Personality": "Zealot", "Protect": 0.6, "Convert": 1.0, "Intimidate": 0.5, "Bless": 0.3, "Opportunism": 0.4, "Thrift": 0.3, "SendCreature": 0.7, "CreatureKindness": 0.3, "Cooperation": 0.3, "Aggression": 0.6, "Treachery": 0.3, "Grudge": 0.7, "RefugeePolicy": "DemandConversion", "HolySites": 0.7, "Domains": ["Justice", "Knowledge", "Death"] },
    { "Personality": "NatureKeeper", "Protect": 0.7, "Convert": 0.5, "Intimidate": 0.1, "Bless": 1.0, "Opportunism": 0.2, "Thrift": 0.5, "SendCreature": 0.3, "CreatureKindness": 0.6, "Cooperation": 0.7, "Aggression": 0.2, "Treachery": 0.1, "Grudge": 0.4, "RefugeePolicy": "Welcome", "HolySites": 0.5, "Domains": ["Nature", "Life", "Storm"] },
    { "Personality": "Trickster", "Protect": 0.4, "Convert": 0.9, "Intimidate": 0.3, "Bless": 0.2, "Opportunism": 1.0, "Thrift": 0.5, "SendCreature": 0.6, "CreatureKindness": 0.0, "Cooperation": 0.8, "Aggression": 0.4, "Treachery": 1.0, "Grudge": 0.3, "RefugeePolicy": "Welcome", "HolySites": 0.6, "Domains": ["Trickery", "Chaos", "Knowledge"] },
    { "Personality": "Isolationist", "Protect": 1.0, "Convert": 0.2, "Intimidate": 0.1, "Bless": 0.8, "Opportunism": 0.1, "Thrift": 0.7, "SendCreature": 0.1, "CreatureKindness": 0.5, "Cooperation": 0.2, "Aggression": 0.1, "Treachery": 0.1, "Grudge": 0.8, "RefugeePolicy": "TurnAway", "HolySites": 0.3, "Domains": ["Ocean", "Protection", "Nature"] },
    { "Personality": "Warlord", "Protect": 0.4, "Convert": 0.4, "Intimidate": 1.0, "Bless": 0.1, "Opportunism": 0.6, "Thrift": 0.3, "SendCreature": 0.9, "CreatureKindness": -0.6, "Cooperation": 0.4, "Aggression": 1.0, "Treachery": 0.4, "Grudge": 0.8, "RefugeePolicy": "DemandConversion", "HolySites": 0.6, "Domains": ["War", "Fire", "Death"] }
  ],

  // Major planning (spec sections 47 and 87, ADR-036). Every PlanSeconds an AI god weighs its goals: protect its
  // home from a danger of HomeDanger or more, convert a village within ConvertReach metres of its own, befriend or
  // weaken a god it knows, prepare for the plague or a drought (the land's dryness past Dryness), slay the ancient
  // beast, and win back its followers when their mean doubt reaches Doubt. It holds up to MaxGoals of weight
  // Threshold or more, one of each kind, each for at least MinGoalSeconds unless it is moot. An action serving a
  // goal is worth Boost times as much; a goal adds DiplomacyBias at full weight to an alliance with a god it means
  // to befriend or a war on one it means to weaken.
  "Planning": {
    "PlanSeconds": 30.0,
    "MaxGoals": 3,
    "MinGoalSeconds": 90.0,
    "Threshold": 0.35,
    "Boost": 2.0,
    "DiplomacyBias": 0.1,
    "HomeDanger": 0.3,
    "ConvertReach": 700.0,
    "Doubt": 0.3,
    "Dryness": 0.65
  }
}
