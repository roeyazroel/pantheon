{
  // Belief, worship, Divine Power and influence (ADR-009). The belief model steps once every
  // StepIntervalTicks ticks (10 ticks = one simulated second at x1); every rate is per step.
  // Values named ...PerStep, Faith..., Love..., Fear... and Doubt... are shares (0..1).
  "StepIntervalTicks": 10,

  // Divine Power per step = worshippers x intensity x infrastructure x PowerPerWorshipperPerStep, where
  // worshippers = workers x WorshipWorkforceShare (settlement_rules.json) x adherence x Faith and
  // intensity = Base + Love x LoveWorshipIntensity + Fear x FearWorshipIntensity.
  "PowerPerWorshipperPerStep": 1.5,
  "BaseWorshipIntensity": 0.5,
  "LoveWorshipIntensity": 0.3,
  "FearWorshipIntensity": 0.6,
  "ShrineInfrastructure": 1.0,
  "TempleInfrastructure": 1.5,
  "ReligionPerLevel": 0.06,

  // Conditions: hardship is the worst of ill health, hunger (stores below ComfortFoodPerPerson per
  // person), DroughtWorry x the drought of the farmland and DangerWorry x the danger (fire or
  // shaking ground).
  "ComfortFoodPerPerson": 2.0,
  "DroughtWorry": 0.5,
  "DangerWorry": 0.6,

  // Disasters (ADR-014): a disaster makes its survivors fear every god they know and doubt that the
  // gods care, by these amounts at full severity (a full earthquake).
  "DisasterFear": 0.4,
  "DisasterDoubt": 0.3,

  // Drift: Faith grows with worship, erodes with Doubt and is forgotten by non-followers; Love grows among comfortable followers,
  // fades and wears down in hardship; Fear fades in safety; Doubt drifts towards SilenceDoubt and
  // rises among followers in hardship.
  "FaithFromWorship": 0.01,
  "FaithErosionFromDoubt": 0.01,
  "FaithForgettingPerStep": 0.008,
  "LoveFromComfort": 0.004,
  "LoveDecayPerStep": 0.002,
  "LoveLossFromHardship": 0.01,
  "FearDecayPerStep": 0.012,
  "SilenceDoubt": 0.25,
  "DoubtDriftPerStep": 0.004,
  "DoubtFromHardship": 0.02,
  "NewBelieverDoubt": 0.5,

  // Conversion: pull = Faith x (Base + Love x LoveConversion + Fear x FearConversion) x (1 - Doubt) draws
  // people who follow no god; push = Doubt x (Base + Fear x FearFragility) x (1 - Love x LoveLoyalty)
  // drives followers away.
  "ConversionPerStep": 0.05,
  "BaseConversion": 0.3,
  "LoveConversion": 0.5,
  "FearConversion": 0.7,
  "ApostasyPerStep": 0.04,
  "BaseApostasy": 0.5,
  "FearFragility": 1.5,
  "LoveLoyalty": 0.6,
  // People who leave a god follow another god in proportion to its pull, or no god in proportion to this.
  "ApostateFreedom": 0.3,
  "ForgottenFaith": 0.01,

  // Influence: each settlement with followers reaches InfluenceBaseRadius + InfluenceRadiusPerSqrtFollower x
  // sqrt(followers) metres, with strength min(1, InfluenceStrength x adherence x Faith) at its centre.
  "InfluenceBaseRadius": 400.0,
  "InfluenceRadiusPerSqrtFollower": 20.0,
  "InfluenceStrength": 2.5,

  // Miracles: people within WitnessRadius metres of a miracle's reach see it; a miracle reaching within
  // SettlementRadius metres of a settlement's centre touches it. Costs scale by 1 + WeakInfluenceCostFactor x
  // (1 - influence). Love for a miracle that answers a need scales from GratitudeFloor (no need) to 1.
  "WitnessRadius": 350.0,
  // A god's Creature carries influence with it, fading to 0 at CreatureInfluenceReach metres.
  "CreatureInfluenceStrength": 0.5,
  "CreatureInfluenceReach": 220.0,
  // ...and further as it grows: its divine affinity (spec section 23, ADR-030) adds this share of
  // the reach per level above the first.
  "CreatureAffinityPerLevel": 0.05,
  "SettlementRadius": 60.0,
  "WeakInfluenceCostFactor": 1.0,
  "GratitudeFloor": 0.4,
  // A miracle plants doubt about the other gods its witnesses follow; a rival's stronger influence at the
  // target raises the cost by ContestedCostFactor x (rival influence - own influence).
  "RivalMiracleDoubt": 0.06,
  "ContestedCostFactor": 1.0,

  // Victory (spec section 115): hold VictoryShare of all followers for VictorySeconds without a break.
  "VictoryShare": 0.6,
  "VictorySeconds": 600.0,
  "PantheonVictory": true,
  // A world may also be won (ADR-027) by conquest, when every opponent holds less than ConquestShare of all
  // followers, or culturally, when a god leads CulturalShare of the living villages while a rival lives on;
  // each for VictorySeconds, when the world was made with that victory on.
  "ConquestShare": 0.05,
  "CulturalShare": 0.75,
  // A pantheon that wins together is a god and its strongest direct allies, at most this many gods
  // (ADR-020): with two, a god allied with two others shares its victory with only one of them.
  "PantheonMaxGods": 2,
  "BlessingDecayPerStep": 0.008,

  // Followers needed for each rank (spec section 13). A god never loses a rank.
  "Ranks": [
    { "Rank": "LesserGod", "Followers": 100 },
    { "Rank": "God", "Followers": 400 },
    { "Rank": "GreaterGod", "Followers": 1200 },
    { "Rank": "HighGod", "Followers": 3000 },
    { "Rank": "Ascendant", "Followers": 8000 }
  ],

  // Holy sites (ADR-021): a site gives the god that keeps it influence of this strength, fading to 0 at
  // this many metres.
  "HolySiteInfluenceStrength": 0.6,
  "HolySiteInfluenceReach": 250.0,

  // Schisms (spec section 34, ADR-021). Where the god most people follow is doubted past Doubt (and holds
  // at least MinimumAdherence of a settlement of MinimumPopulation people), Share of its followers break
  // away to keep its Old Faith, taking DoubtRelief of the doubt with them. A god that harms people who love
  // it plants BetrayalDoubt x their Love of extra doubt. The Old Faith follows no god: it returns to the
  // god at ReturnPerStep while the god is loved (ReconcileLove) and trusted (ReconcileDoubt) there, and
  // fades into unbelief at FadePerStep otherwise. A settlement splits again only after CooldownSeconds.
  "Schism": {
    "Doubt": 0.6,
    "MinimumAdherence": 0.4,
    "MinimumPopulation": 20,
    "Share": 0.4,
    "DoubtRelief": 0.5,
    "BetrayalDoubt": 0.5,
    "ReconcileLove": 0.45,
    "ReconcileDoubt": 0.35,
    "ReturnPerStep": 0.02,
    "FadePerStep": 0.004,
    "CooldownSeconds": 600.0
  },

  // Culture (spec sections 7, 8, 11 and 32-35, ADR-024). Per belief step unless named per second.
  // Resentment: fear breeds it (ResentmentFromFear x fear x room), love dissolves it, and a god's harm
  // to its own followers adds ResentmentFromHarm. Dependency: help in need adds DependencyFromHelp x
  // need; it fades by DependencyFade; the dependent doubt more in hardship (DependencyExpectation) and
  // worship more (DependencyWorship). Sacrifice makes fear worship harder (SacrificeWorship).
  // Secularism: each unit loses SecularPowerLoss of the worship, SecularResistance of the gods' pull
  // and MiracleResistance of a miracle's effect, and adds SecularScience to learning; a settlement is
  // agnostic, atheist and anti-divine from those levels; anti-divine ones turn AntiDivineApostasy of
  // every god's followers away a step and spread their reason. Doctrines drift DoctrineDriftPerSecond
  // towards what the people live through and are embraced from Embraced; a miracle that touches one
  // adds DoctrineFromMiracle; DoctrineEffect scales what they do. Charity shares food, temples send
  // missionaries, resentment past RebellionResentment raises revolt. Conduct fades by
  // ConductFadePerSecond; traits show from TraitThreshold; betraying love when known for mercy adds
  // Contradiction x the usual doubt.
  "Culture": {
    "ResentmentFromFear": 0.004,
    "ResentmentFromLove": 0.01,
    "ResentmentFromHarm": 0.15,
    "DependencyFromHelp": 0.12,
    "DependencyFade": 0.002,
    "DependencyExpectation": 0.006,
    "DependencyWorship": 0.3,
    "SacrificeWorship": 0.5,
    "SecularPowerLoss": 0.8,
    "SecularResistance": 0.8,
    "MiracleResistance": 0.6,
    "SecularScience": 0.5,
    "Agnostic": 0.3,
    "Atheist": 0.55,
    "AntiDivine": 0.8,
    "AntiDivineApostasy": 0.005,
    "SecularSpreadPerSecond": 0.002,
    "Secular": { "Doubt": 0.6, "Godless": 0.4, "Schism": 0.5, "Resentment": 0.4, "Science": 0.05, "Faith": 0.5 },
    "SecularDriftPerSecond": 0.004,
    "DoctrineDriftPerSecond": 0.002,
    "Embraced": 0.5,
    "DoctrineFromMiracle": 0.03,
    "DoctrineEffect": 0.5,
    "CharityPerSecond": 0.01,
    "MissionPerSecond": 0.002,
    "MissionRange": 5,
    "RebellionResentment": 0.5,
    "RebellionShare": 0.4,
    "RebellionVent": 0.5,
    "ConductFadePerSecond": 0.0005,
    "TraitThreshold": 5.0,
    "Contradiction": 1.0
  },
  // The Divine Hand (spec section 55, ADR-030), where the god's influence reaches at least
  // MinInfluence. Within Reach metres it lifts the god's Creature, else up to VillagersPerGrab people
  // (at most MaxShare of a village), else a tree from land at least TreeVegetation green (taking
  // TreeCover of it) or a rock. People lifted out of danger and set down safe feel Rescue, and so
  // does everyone within WitnessRadius; people taken from a safe home, and those left, feel
  // Abduction. A thrown rock wrecks ThrowHousingLoss of the houses and kills ThrowDeaths of the
  // people within ThrowRadius metres at the centre (a tree or a body TreeThrowFactor as much),
  // harms the land by ThrowLandHarm and makes those it strikes feel Smiting; a thrown Creature loses
  // ThrownCreatureHealth. A planted tree makes the village beside it feel Planting.
  "Hand": {
    "Enabled": true,
    "MinInfluence": 0.05,
    "Reach": 60.0,
    "VillagersPerGrab": 10,
    "MaxShare": 0.25,
    "TreeVegetation": 0.6,
    "TreeCover": 0.05,
    "ThrowRadius": 25.0,
    "ThrowHousingLoss": 0.15,
    "ThrowDeaths": 0.04,
    "TreeThrowFactor": 0.6,
    "ThrowLandHarm": 0.3,
    "ThrownCreatureHealth": 0.15,
    "WitnessRadius": 300.0,
    "Rescue": { "Faith": 0.05, "Love": 0.15, "Fear": 0.0, "Doubt": -0.05 },
    "Abduction": { "Faith": 0.0, "Love": -0.05, "Fear": 0.08, "Doubt": 0.05 },
    "Smiting": { "Faith": 0.02, "Love": -0.1, "Fear": 0.2, "Doubt": 0.0 },
    "Planting": { "Faith": 0.01, "Love": 0.03, "Fear": 0.0, "Doubt": 0.0 }
  }
}
