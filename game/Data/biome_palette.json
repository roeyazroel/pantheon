{
  // Presentation only: ground colours per biome plus blending thresholds (heights in metres).
  "Grassland": "#7ea44a",
  "Forest": "#3f6a32",
  "Highland": "#8b8470",
  "Desert": "#d8b46a",
  "Tundra": "#8e9c7e",
  "Swamp": "#4f5e34",
  "Coast": "#b9bd7e",
  "RiverValley": "#5f9a3c",
  "Island": "#86ad55",
  "Volcanic": "#4a4240",
  // Land biomes' colours blend over this many metres, so no border is a hard line (ADR-038).
  "BiomeBlendMetres": 8.0,
  "SeaFloor": "#2b4a52",
  "Beach": "#d6c28c",
  "Rock": "#6e6860",
  "Snow": "#eef1f4",
  "ShallowWater": "#3fa4b8",
  "DeepWater": "#123f5c",
  "RegionBoundary": "#f4ead2",
  "RegionHighlight": "#ffd34d",
  "BeachMaxHeight": 2.5,
  "SnowStartHeight": 112.0,
  "SnowBlendRange": 18.0,
  "RockSlopeStart": 0.7,
  "RockSlopeFull": 1.4,
  "DeepWaterDepth": 18.0,
  "ColorVariation": 0.05,

  // The ground's textures (spec section 61, ADR-051). Each is made in code from noise between its
  // darker and lighter colour, with its own pattern (grass blades, leaf litter, pebbles, strata,
  // ripples, drifts, moss, puddles, cinders) and a normal map. The biome colours above tint them by
  // TintStrength; UvScale is how often they repeat (Terrain3D's UV scale).
  "Ground": {
    "Textures": {
      "Grass": ["#3d6326", "#9db25e"],
      "ForestFloor": ["#2b3420", "#7d6642"],
      "Earth": ["#5f4a33", "#9c8058"],
      "Rock": ["#57524c", "#a39d93"],
      "Sand": ["#bfa16b", "#ead9a8"],
      "Snow": ["#cfd8e3", "#ffffff"],
      "Moss": ["#5f6b4c", "#a2a684"],
      "Mud": ["#2f2c1e", "#5e573a"],
      "Ash": ["#26221f", "#5a524b"]
    },
    "TintStrength": 0.15,
    "UvScale": 0.1
  }
}
