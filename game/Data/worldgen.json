{
  // PANTHEON world generation. Distances are in metres, noise frequencies in cycles per metre.
  // The heightfield is HeightmapResolution^2 samples, VertexSpacing metres apart (2048 m island).
  "HeightmapResolution": 1024,
  "VertexSpacing": 2.0,
  "RegionsPerSide": 32,
  "Shape": {
    "IslandFalloffStart": 0.5,
    "IslandFalloffEnd": 1.0,
    "RidgeWeight": 0.6,
    "RidgeMaskStart": 0.5,
    "RidgeMaskEnd": 0.7,
    "SeaLevel": 0.24,
    "LandExponent": 1.5,
    "MaxElevation": 180.0,
    "MaxDepth": 40.0
  },
  "ElevationNoise": { "Frequency": 0.0011, "Octaves": 5, "Lacunarity": 2.0, "Gain": 0.5 },
  "RidgeNoise": { "Frequency": 0.0024, "Octaves": 4, "Lacunarity": 2.1, "Gain": 0.5 },
  "MoistureNoise": { "Frequency": 0.0016, "Octaves": 3, "Lacunarity": 2.0, "Gain": 0.5 },
  "TemperatureNoise": { "Frequency": 0.0009, "Octaves": 2, "Lacunarity": 2.0, "Gain": 0.5 },
  "Climate": {
    "BaseTemperature": 0.62,
    "TemperatureVariation": 0.12,
    "LapseRate": 0.6,
    "CoastalMoistureBonus": 0.15,
    "CoastalMoistureRange": 25.0
  },
  // Ordered: the first matching rule wins and the last rule must have no bounds. The climate decides
  // these biomes (spec section 5, ADR-038): tundra is the cold land below the heights, desert hot dry
  // land, swamp wet low land.
  "Biomes": [
    { "Biome": "Sea", "MaxElevation": 0.0, "BaseFertility": 0.0, "BaseVegetation": 0.0 },
    { "Biome": "Highland", "MinElevation": 70.0, "BaseFertility": 0.25, "BaseVegetation": 0.2 },
    { "Biome": "Tundra", "MaxTemperature": 0.4, "BaseFertility": 0.3, "BaseVegetation": 0.35 },
    { "Biome": "Desert", "MinTemperature": 0.56, "MaxMoisture": 0.4, "BaseFertility": 0.25, "BaseVegetation": 0.1 },
    { "Biome": "Swamp", "MinMoisture": 0.8, "MaxElevation": 8.0, "BaseFertility": 0.5, "BaseVegetation": 0.85 },
    { "Biome": "Forest", "MinMoisture": 0.55, "BaseFertility": 0.6, "BaseVegetation": 0.9 },
    { "Biome": "Grassland", "BaseFertility": 0.9, "BaseVegetation": 0.5 }
  ],
  // Biomes that place decides (ADR-038), marked after the climate's and the rivers, in this order:
  // every land mass but the largest under IslandMaxArea square metres is an island; land within
  // VolcanicMetres of the highest land region's centre is volcanic when that region rises
  // VolcanoMinElevation metres (keep it equal to the volcano's MinElevation in disasters.json); land
  // within ValleyMetres of a river or lake and no higher than ValleyMaxHeight is a river valley, where
  // it was one of ValleyOver; land within CoastMetres of the sea and no higher than CoastMaxHeight is
  // coast, where it was one of CoastOver. Traits give their fertility and vegetation.
  "Landforms": {
    "IslandMaxArea": 120000.0,
    "CoastMetres": 32.0,
    "CoastMaxHeight": 10.0,
    "CoastOver": [ "Grassland", "Forest" ],
    "ValleyMetres": 30.0,
    "ValleyMaxHeight": 40.0,
    "ValleyOver": [ "Grassland", "Forest", "Desert", "Tundra" ],
    "VolcanoMinElevation": 60.0,
    "VolcanicMetres": 140.0,
    "Traits": [
      { "Biome": "Coast", "BaseFertility": 0.65, "BaseVegetation": 0.35 },
      { "Biome": "RiverValley", "BaseFertility": 1.0, "BaseVegetation": 0.65 },
      { "Biome": "Island", "BaseFertility": 0.7, "BaseVegetation": 0.6 },
      { "Biome": "Volcanic", "BaseFertility": 0.8, "BaseVegetation": 0.25 }
    ]
  },
  // Up to Count settlements on the best habitable regions, at least MinimumSpacing regions apart
  // (with the farmland radius of 2, a spacing of 5 keeps their farmland apart).
  "StartingSettlement": {
    "Count": 8,
    "MinimumSpacing": 5,
    "Population": 40,
    "PopulationVariation": 0.35,
    "Food": 120.0,
    "Water": 120.0,
    "Wood": 30.0,
    "Stone": 15.0,
    "Housing": 60,
    "CenterPreference": 0.35,
    "WaterPreference": 0.3,
    "Names": [
      "Aldermere",
      "Brightwater",
      "Thornhollow",
      "Kestrel Rise",
      "Emberfield",
      "Mossgate",
      "Saltreach",
      "Larkspur",
      "Elar",
      "Valen",
      "Cinderford",
      "Wrenmoor",
      "Ashcombe",
      "Fernhollow",
      "Duskwater",
      "Harrowmere"
    ]
  },
  // Rivers and lakes (ADR-022). Water runs over a grid of CellSize-metre cells: hollows deeper than
  // MinLakeDepth over at least MinLakeArea square metres hold lakes, and a river runs where at least
  // RiverCatchment square metres of fully wet land drain, up to where HeadwaterCatchment do. Up to MaxRivers rivers (tributaries
  // included, the MaxMainRivers longest reaching the sea) at least MinRiverLength long are cut into the land, MinChannelWidth..MaxChannelWidth
  // wide and MinChannelDepth..MaxChannelDepth deep as they grow, their water Freeboard below the
  // land, with BankWidth of sloping bank. A region with FullWaterShare of its ground under fresh
  // water is fully watered.
  "Hydrology": {
    "CellSize": 8.0,
    "RiverCatchment": 6000.0,
    "HeadwaterCatchment": 700.0,
    "MaxRivers": 7,
    "MaxMainRivers": 4,
    "MinRiverLength": 220.0,
    "MinChannelWidth": 5.0,
    "MaxChannelWidth": 16.0,
    "MinChannelDepth": 1.2,
    "MaxChannelDepth": 3.0,
    "BankWidth": 10.0,
    "Freeboard": 0.8,
    "SmoothingPasses": 3,
    "MinLakeDepth": 1.5,
    "MinLakeArea": 2500.0,
    "FullWaterShare": 0.08,
    "RiverNames": [ "Silverrun", "Ashwater", "Brenna", "Coldbrook", "Elderflow", "Fennick", "Greywash", "Lowan", "Mirewind", "Rushmere" ],
    "LakeNames": [ "Stillmere", "Orrin Water", "Glasslake", "Hollowmere", "Duskpool", "Reedwater" ]
  },
  // Forests and stone (spec section 93, ADR-033): a region's forest is its biome's Forest times its
  // vegetation and its stone its biome's Stone, both varied by up to PatchStrength in patches about
  // PatchSize metres across.
  "Resources": {
    "Biomes": [
      { "Biome": "Grassland", "Forest": 0.8, "Stone": 0.15 },
      { "Biome": "Forest", "Forest": 1.1, "Stone": 0.2 },
      { "Biome": "Highland", "Forest": 1.6, "Stone": 0.75 },
      { "Biome": "Desert", "Forest": 1.0, "Stone": 0.3 },
      { "Biome": "Tundra", "Forest": 1.4, "Stone": 0.4 },
      { "Biome": "Swamp", "Forest": 0.9, "Stone": 0.05 },
      { "Biome": "Coast", "Forest": 0.6, "Stone": 0.1 },
      { "Biome": "RiverValley", "Forest": 0.9, "Stone": 0.1 },
      { "Biome": "Island", "Forest": 1.0, "Stone": 0.2 },
      { "Biome": "Volcanic", "Forest": 0.8, "Stone": 0.9 }
    ],
    "PatchSize": 500.0,
    "PatchStrength": 0.6
  }
}
