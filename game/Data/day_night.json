  "Sunset": 20.0,
  "HeldHour": 16.2,
  "HighestSun": 62.0,
  "HighestMoon": 48.0,
  "LowestLight": 7.0,

  // At night up to AsleepShare of a village's people are indoors, lit windows show Lamplight, and a
  // light of ShrineLight strength burns by each shrine, reaching ShrineLightReach metres.
