{
  // Statistical (Tier 1) settlement model. It steps once every StepIntervalTicks ticks
  // (10 ticks = one simulated second at x1) and every rate below is per step (ADR-008).
  "StepIntervalTicks": 10,

  // Labour and farmland. Production = FoodPerFarmerPerStep * mean fertility * capacity * (1 - e^(-farmers / capacity)),
  // where capacity = FarmersPerRegion * land regions within FarmlandRadius of the settlement's region.
  "WorkforceShare": 0.6,
  "FarmlandRadius": 2,
  "FarmersPerRegion": 12.0,
  "FoodPerFarmerPerStep": 0.3,

  // Blessed land (the Bless Crops miracle) yields up to this share more. A settlement's workers
  // spend up to WorshipWorkforceShare of their time worshipping, scaled by its followers' Faith (ADR-009).
  "BlessingYieldBonus": 0.6,
  "WorshipWorkforceShare": 0.15,

  // Water (weather.json, ADR-013): farmland whose mean soil moisture is at least WellWateredSoil
  // yields fully; drier land yields less, down to DroughtYieldFloor of it when parched. The drought
  // is 1 - soil / WellWateredSoil, and a settlement is in drought from DroughtThreshold.
  "WellWateredSoil": 0.35,
  "DroughtYieldFloor": 0.25,
  "DroughtThreshold": 0.35,

  // Disasters (disasters.json, ADR-014): scorched farmland loses up to ScorchYieldLoss of its yield;
  // people without a roof lose health; rebuilding a ruin takes RuinWorkShare of a new house's work.
  "ScorchYieldLoss": 0.7,
  "HomelessHealthLossPerStep": 0.02,
  "RuinWorkShare": 0.5,

  // Food.
  "FoodPerPersonPerStep": 0.05,
  "FoodStoragePerHousing": 8.0,
  "SurplusFoodPerPerson": 2.0,

  // Health: starvation lowers it by the unfed share of the loss; fed villagers recover.
  "StarvationHealthLossPerStep": 0.02,
  "HealthRecoveryPerStep": 0.005,

  // Births scale with health; deaths rise with (1 - health)^2.
  "BirthChancePerPersonPerStep": 0.004,
  "DeathChancePerPersonPerStep": 0.0004,
  "IllHealthDeathChancePerPersonPerStep": 0.02,

  // Housing and autonomous construction: one house at a time, started when crowded and paused
  // while the stores hold less than ConstructionFoodReserveSteps of consumption.
  "HousingPerHouse": 5,
  "ConstructionStartCrowding": 0.85,
  "MaxBuilderShare": 0.2,
  "BuildersPerSite": 10.0,
  "WorkPerHouse": 100.0,
  "ConstructionFoodReserveSteps": 20.0,
  "MaxHousing": 1000,

  // Water (ADR-022): flooded farmland loses up to FloodYieldLoss of its harvest. People drink WaterPerPersonPerStep from wells and cisterns that hold
  // WaterStoragePerHousing per unit of housing. Each step they draw WaterGatherFactor times what they
  // drink, times their access: a river or lake in their own region (FreshWaterAccess) or next to it
  // (NeighbourWaterAccess), plus deep wells (WellFloor) and shallow wells that dry up with the soil
  // (WellAccess x soil / WellWateredSoil). Without water, health falls by ThirstHealthLossPerStep
  // times the share left thirsty.
  "FloodYieldLoss": 0.8,
  "WaterPerPersonPerStep": 0.05,
  "WaterStoragePerHousing": 3.0,
  "WaterGatherFactor": 1.5,
  "FreshWaterAccess": 1.0,
  "NeighbourWaterAccess": 0.8,
  "WellFloor": 0.25,
  "WellAccess": 0.5,
  "ThirstHealthLossPerStep": 0.015,

  // What a settlement's technology (per level, society.json caps it at 5) and buildings do (ADR-023):
  // richer harvests, faster healing and fewer deaths from ill health, houses that take less work,
  // larger stores with a granary or cistern, and walls and arms that turn attacks away. A priority
  // (spec 29) brings FoodPriorityYield more harvest, HealthPriorityRecovery health a step, GrowthPriorityBirths
  // more births, or WorshipPriorityFactor times the worship.
  "Civics": {
    "AgriculturePerLevel": 0.06,
    "MedicinePerLevel": 0.002,
    "MedicineDeathsPerLevel": 0.08,
    "ArchitecturePerLevel": 0.06,
    "GranaryStorage": 1.5,
    "CisternStorage": 2.0,
    "HospitalRecovery": 0.005,
    "HospitalDeaths": 0.3,
    "WallsDefence": 0.5,
    "WarfarePerLevel": 0.08,
    "FoodPriorityYield": 0.15,
    "HealthPriorityRecovery": 0.003,
    "GrowthPriorityBirths": 0.4,
    "WorshipPriorityFactor": 2.0,
    // Irrigation supplies this share of its fields' missing soil water (ADR-029).
    "IrrigationWater": 0.5
  },
  // Wood and stone (spec sections 5 and 29, ADR-033). While its stores hold less than WoodPerHousing
  // and StonePerHousing a place of housing (at least MinWoodStore and MinStoneStore), up to
  // GatherShare of a village's workforce gathers instead of farming, from the land GatherRadius
  // regions around: each brings WoodPerGathererPerStep wood from fully wooded land and
  // StonePerGathererPerStep stone from land full of stone. Each unit cut takes TimberPerWood of the
  // land's timber, and each unit quarried StonePerStone of its stone. A new house takes WoodPerHouse
  // wood. Timber grows back TimberRegrowthPerSecond of the way to the land's forest a second, and
  // fire burns TimberBurnPerSecond a second; a cleared forest holds ClearedWildlife less wildlife,
  // and a cleared slope slides ClearedLandslide times more often.
  "Resources": {
    "GatherShare": 0.15,
    "GatherRadius": 2,
    "WoodPerGathererPerStep": 0.5,
    "StonePerGathererPerStep": 0.3,
    "WoodPerHousing": 0.4,
    "StonePerHousing": 0.2,
    "MinWoodStore": 30.0,
    "MinStoneStore": 20.0,
    "WoodPerHouse": 6.0,
    "TimberPerWood": 0.02,
    "StonePerStone": 0.005,
    "TimberRegrowthPerSecond": 0.003,
    "TimberBurnPerSecond": 0.1,
    "ClearedWildlife": 0.5,
    "ClearedLandslide": 1.0
  },
  // Roads (spec section 29, ADR-033). A village of at least MinPopulation builds a road to its
  // nearest neighbour within Range metres that has none, one at a time: WorkShare of its workforce
  // lays MetresPerWorkerPerSecond metres each a second, each metre taking StonePerMetre stone. On a
  // whole road walkers within Width metres go Speed times as fast; it brings each of its villages
  // TradeWealthPerSecond wealth a second, and carries up to FoodReliefPerSecond food a second to a
  // village with less than HungerSteps steps of food from one with three times as many. Flood, fire
  // and rubble on the way wear it WearPerSecond a second at full strength, until it is cut at
  // CutWear; its villages mend RepairPerSecond a second, and it decays DecayPerSecond a second when a
  // village is gone.
  "Roads": {
    "MinPopulation": 50,
    "Range": 700.0,
    "WorkShare": 0.05,
    "MetresPerWorkerPerSecond": 0.5,
    "StonePerMetre": 0.02,
    "Speed": 1.6,
    "Width": 20.0,
    "TradeWealthPerSecond": 0.01,
    "FoodReliefPerSecond": 1.0,
    "HungerSteps": 10.0,
    "WearPerSecond": 0.015,
    "RepairPerSecond": 0.005,
    "CutWear": 0.6,
    "DecayPerSecond": 0.002
  },
  // The villagers gods follow (ADR-043): / makes the figure at the cursor an individual, named from
  // Names, aged MinAge to MaxAge years (a year being SecondsPerYear seconds), who dies of age between
  // MinLifeYears and MaxLifeYears. They walk Speed metres a second, are in their village within
  // VillageRadius of its centre, and their home, work and shrine lie within SpotRange of it. Hunger
  // grows HungerPerSecond a second and eating from the stores takes EatPerSecond away; work tires them
  // FatiguePerSecond a second (walking half as much) and rest takes RestPerSecond away. They choose
  // what to do by their hunger, their fatigue, WorkDrive times their strength, and WorshipDrive times
  // their faith (less within WorshipGapSeconds of praying), with HardshipWorship more for a hardship
  // in the last HardshipSeconds; work, a meal, rest and prayer last WorkSeconds, EatSeconds,
  // RestSeconds and WorshipSeconds. Starving costs StarvePerSecond health a second, the plague
  // PlagueHarmPerSecond times the share sick, and they heal HealPerSecond. They flee at FleeDanger
  // (WaryFlee of it once they have known danger) to a safe village within FleeRange, else
  // FleeDistance metres out, and die with chance Mortality a second times the danger. Their faith
  // follows their village's FaithDrift a second and grows WorshipFaith a second in prayer; a miracle
  // within WitnessRadius metres, or a prophet, of their god gives WitnessFaith, another god's takes
  // half as much; below ConvertFaith they turn to the god most of the village follows. They remember
  // MemoryCapacity things.
  "Villagers": {
    "Names": [
      "Mara", "Tobin", "Ilse", "Corwin", "Neve", "Aldo", "Brin", "Cass", "Doran", "Edda",
      "Fen", "Greta", "Hale", "Ina", "Jory", "Kestra", "Lio", "Mira", "Nils", "Orla",
      "Pell", "Quin", "Rhea", "Soren", "Tamsin", "Ulric", "Vesna", "Wren", "Yara", "Zev",
      "Anouk", "Bram", "Ciel", "Dagny", "Emrys", "Faye", "Gunnar", "Hesper", "Ivo", "Juna"
    ],
    "SecondsPerYear": 90.0,
    "MinAge": 16.0,
    "MaxAge": 60.0,
    "MinLifeYears": 58.0,
    "MaxLifeYears": 86.0,
    "Speed": 1.4,
    "VillageRadius": 60.0,
    "SpotRange": 150.0,
    "HungerPerSecond": 0.0035,
    "EatPerSecond": 0.04,
    "FatiguePerSecond": 0.003,
    "RestPerSecond": 0.012,
    "WorkDrive": 0.5,
    "WorshipDrive": 0.6,
    "WorshipGapSeconds": 180.0,
    "HardshipWorship": 0.25,
    "HardshipSeconds": 300.0,
    "WorkSeconds": 60.0,
    "EatSeconds": 15.0,
    "RestSeconds": 40.0,
    "WorshipSeconds": 25.0,
    "StarvePerSecond": 0.004,
    "HealPerSecond": 0.002,
    "PlagueHarmPerSecond": 0.004,
    "FleeDanger": 0.25,
    "WaryFlee": 0.6,
    "FleeRange": 800.0,
    "FleeDistance": 80.0,
    "Mortality": 0.01,
    "FaithDrift": 0.01,
    "WorshipFaith": 0.004,
    "WitnessRadius": 150.0,
    "WitnessFaith": 0.05,
    "ConvertFaith": 0.3,
    "MemoryCapacity": 24
  }
}
