{
  // Statistical (Tier 1) settlement model. It steps once every StepIntervalTicks ticks
  // (10 ticks = one simulated second at x1) and every rate below is per step (ADR-008).
  "StepIntervalTicks": 10,

  // Labour and farmland. Production = FoodPerFarmerPerStep * mean fertility * capacity * (1 - e^(-farmers / capacity)),
  // where capacity = FarmersPerRegion * land regions within FarmlandRadius of the settlement's region.
  "WorkforceShare": 0.6,
  "FarmlandRadius": 2,
  "FarmersPerRegion": 12.0,
  "FoodPerFarmerPerStep": 0.3,

  // Blessed land (the Bless Crops miracle) yields up to this share more. A settlement's workers
  // spend up to WorshipWorkforceShare of their time worshipping, scaled by its followers' Faith (ADR-009).
  "BlessingYieldBonus": 0.6,
  "WorshipWorkforceShare": 0.15,

  // Water (weather.json, ADR-013): farmland whose mean soil moisture is at least WellWateredSoil
  // yields fully; drier land yields less, down to DroughtYieldFloor of it when parched. The drought
  // is 1 - soil / WellWateredSoil, and a settlement is in drought from DroughtThreshold.
  "WellWateredSoil": 0.35,
  "DroughtYieldFloor": 0.25,
  "DroughtThreshold": 0.35,

  // Disasters (disasters.json, ADR-014): scorched farmland loses up to ScorchYieldLoss of its yield;
  // people without a roof lose health; rebuilding a ruin takes RuinWorkShare of a new house's work.
  "ScorchYieldLoss": 0.7,
  "HomelessHealthLossPerStep": 0.02,
  "RuinWorkShare": 0.5,

  // Food.
  "FoodPerPersonPerStep": 0.05,
  "FoodStoragePerHousing": 8.0,
  "SurplusFoodPerPerson": 2.0,

  // Health: starvation lowers it by the unfed share of the loss; fed villagers recover.
  "StarvationHealthLossPerStep": 0.02,
  "HealthRecoveryPerStep": 0.005,

  // Births scale with health; deaths rise with (1 - health)^2.
  "BirthChancePerPersonPerStep": 0.004,
  "DeathChancePerPersonPerStep": 0.0004,
  "IllHealthDeathChancePerPersonPerStep": 0.02,

  // Housing and autonomous construction: one house at a time, started when crowded and paused
  // while the stores hold less than ConstructionFoodReserveSteps of consumption.
  "HousingPerHouse": 5,
  "ConstructionStartCrowding": 0.85,
  "MaxBuilderShare": 0.2,
  "BuildersPerSite": 10.0,
  "WorkPerHouse": 100.0,
  "ConstructionFoodReserveSteps": 20.0,
  "MaxHousing": 1000,

  // Water (ADR-022): flooded farmland loses up to FloodYieldLoss of its harvest. People drink WaterPerPersonPerStep from wells and cisterns that hold
  // WaterStoragePerHousing per unit of housing. Each step they draw WaterGatherFactor times what they
  // drink, times their access: a river or lake in their own region (FreshWaterAccess) or next to it
  // (NeighbourWaterAccess), plus deep wells (WellFloor) and shallow wells that dry up with the soil
  // (WellAccess x soil / WellWateredSoil). Without water, health falls by ThirstHealthLossPerStep
  // times the share left thirsty.
  "FloodYieldLoss": 0.8,
  "WaterPerPersonPerStep": 0.05,
  "WaterStoragePerHousing": 3.0,
  "WaterGatherFactor": 1.5,
  "FreshWaterAccess": 1.0,
  "NeighbourWaterAccess": 0.8,
  "WellFloor": 0.25,
  "WellAccess": 0.5,
  "ThirstHealthLossPerStep": 0.015,

  // What a settlement's technology (per level, society.json caps it at 5) and buildings do (ADR-023):
  // richer harvests, faster healing and fewer deaths from ill health, houses that take less work,
  // larger stores with a granary or cistern, and walls and arms that turn attacks away. A priority
  // (spec 29) brings FoodPriorityYield more harvest, HealthPriorityRecovery health a step, GrowthPriorityBirths
  // more births, or WorshipPriorityFactor times the worship.
  "Civics": {
    "AgriculturePerLevel": 0.06,
    "MedicinePerLevel": 0.002,
    "MedicineDeathsPerLevel": 0.08,
    "ArchitecturePerLevel": 0.06,
    "GranaryStorage": 1.5,
    "CisternStorage": 2.0,
    "HospitalRecovery": 0.005,
    "HospitalDeaths": 0.3,
    "WallsDefence": 0.5,
    "WarfarePerLevel": 0.08,
    "FoodPriorityYield": 0.15,
    "HealthPriorityRecovery": 0.003,
    "GrowthPriorityBirths": 0.4,
    "WorshipPriorityFactor": 2.0
  }
}
