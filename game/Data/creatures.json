  // Needs grow over time; actions ease them (Actions below).
  "HungerPerSecond": 0.005,
  "FatiguePerSecond": 0.004,
  "BoredomPerSecond": 0.006,
  "HungryThreshold": 0.55,
  "TiredThreshold": 0.7,
  "BoredThreshold": 0.6,
  "StarvationHealthLossPerSecond": 0.01,
  "RestHealthPerSecond": 0.01,
  "BanishedSeconds": 60.0,

  // A settlement whose food or health need reaches this counts as in need.
  "VillageNeedThreshold": 0.5,

  // Learning (spec section 25): a reward closes RewardLearningRate of the gap to 1 in the judged
  // preference, a punishment removes PunishmentLearningRate of it; both nudge the trait behind the
  // action and change loyalty. They judge the current action or one finished within the window.
  "RewardLearningRate": 0.25,
  "PunishmentLearningRate": 0.35,
  "PersonalityNudge": 0.04,
  "StartingLoyalty": 0.7,
  "LoyaltyPerReward": 0.02,
  "LoyaltyPerPunishment": 0.04,
  "FeedbackWindowSeconds": 15.0,
  "CommandStaySeconds": 30.0,
  "MemoryCapacity": 12,
  "PersonalitySpread": 0.25,

  // Experience for levels 2 to 10 (spec section 23: MVP maximum 10).
  "LevelExperience": [40.0, 100.0, 180.0, 280.0, 400.0, 540.0, 700.0, 880.0, 1080.0],

