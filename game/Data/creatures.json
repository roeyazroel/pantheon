  // How Creatures meet and regard each other (spec section 27, ADR-017). Gains close that share of
  // the gap to 1; losses remove that share. Two Creatures meet within MeetRadius metres, at most once
  // every MeetCooldownSeconds; a Creature may go looking for another within SeekRadius, and run from
  // one within FleeRadius.
  "Bonds": {
    "MeetRadius": 40.0,
    "MeetCooldownSeconds": 120.0,
    "SeekRadius": 400.0,
    "FleeRadius": 150.0,
    "StartingTrust": 0.3,
    "WarFightDrive": 0.4,
    "AllianceBefriendDrive": 0.3,
