  // Fights (spec sections 28 and 111, ADR-017). Each of two equal Creatures loses DamagePerSecond of
  // health per second; power is strength x (1 + SkillPower x combat skill). At YieldHealth a
  // Creature is beaten: a winner whose mercy reaches SpareThreshold lets it go, otherwise it is
  // banished with a scar and loses loyalty and a share of its progress towards the next level.
  "Combat": {
    "DamagePerSecond": 0.05,
    "Jitter": 0.5,
    "SkillPower": 1.0,
    "YieldHealth": 0.25,
    "SkillPerFight": 0.1,
    "WinnerExperience": 6.0,
    "DefeatExperienceLoss": 0.15,
    "LoyaltyPerDefeat": 0.03,
    "AggressionPerVictory": 0.01,
    "AggressionPerDefeat": 0.03,
    "FightLearningRate": 0.03,
    "SpareThreshold": 0.5,
    "WitnessRadius": 300.0,
    "VictoryWitness": { "Faith": 0.06, "Love": 0.0, "Fear": 0.08, "Doubt": -0.04 },
    "DefeatWitness": { "Faith": -0.04, "Love": 0.0, "Fear": 0.0, "Doubt": 0.08 }
  },
  // Paths (spec sections 23 and 24, ADR-030). At each of Levels a Creature takes up the path its
  // deeds have called it to most: each deed below calls it by its Weight, a rewarded deed by
  // RewardCalling more, a fight won towards Warrior and a beaten foe spared towards Guardian.
  // Intelligence (how fast it learns) and resilience (how little harm it takes) grow per level.
  // A Guardian spares its god's villages within GuardRadius metres GuardianShield of a disaster's
  // harm, and a Commander gives them CommanderDefence against Creatures' attacks; a Warrior has
  // WarriorPower more combat power and a Destroyer's attacks kill DestroyerAttack more; a Healer's
  // deed in a village gives HealerHealth, a Nature Keeper's heals KeeperHealing of the harm and blight
  // around it, a Missionary's wins MissionaryConversion of the godless, and a Trickster's sows
  // TricksterDoubt in the village's main rival god.
  "Callings": {
    "Levels": [3, 6, 9],
    "Deeds": [
      { "Action": "Feed", "Specialisation": "Healer", "Weight": 1.0 },
      { "Action": "Feed", "Specialisation": "Guardian", "Weight": 0.3 },
      { "Action": "HelpBuild", "Specialisation": "Guardian", "Weight": 1.0 },
      { "Action": "HelpBuild", "Specialisation": "Commander", "Weight": 0.3 },
