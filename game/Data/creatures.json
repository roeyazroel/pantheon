    { "Name": "Lumen", "Description": "A gentle, glowing beast that learns quickly from its god but is frail in a fight.",
      "Toughness": 0.85, "Strength": 0.85, "Speed": 1.1, "Learning": 1.5, "Kindness": 0.15, "Aggression": -0.1 }
  ],
