{
  // Creatures (ADR-010). Rates are per simulated second; distances in metres. The Creature moves
  // every tick and decides at most every DecisionIntervalTicks ticks (2 ticks = 5 Hz at x1).
  "DecisionIntervalTicks": 2,
  // Species (ADR-021): their factors scale the rules below. Toughness divides the harm a Creature takes;
  // Kindness and Aggression are added to the temperament it is born with. The first is the default.
  "Species": [
    { "Name": "Mossback", "Description": "A patient, moss-covered beast, steady in all things.",
      "Toughness": 1.0, "Strength": 1.0, "Speed": 1.0, "Learning": 1.0, "Kindness": 0.0, "Aggression": 0.0 },
    { "Name": "Stonehide", "Description": "Slow and massive, with a hide like granite: hard to hurt and strong, but slow to learn.",
