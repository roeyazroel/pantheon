{
  // Relations between gods (spec sections 37-41 and 113, ADR-012). The diplomacy step runs every
  // StepIntervalTicks ticks; rates below are per step, act effects once per act. Values are shares (0..1).
  "StepIntervalTicks": 10,
  "StartingTrust": 0.5,
  "StartingRivalry": 0.2,
  "StartingSuspicion": 0.2,
  "DriftPerStep": 0.004,
  "MemoryFadePerStep": 0.004,
  "BetrayalFadePerStep": 0.0005,
  "MemoryCapacity": 16,

  // Proposals wait ProposalSeconds for an answer and are at least ProposalCooldownSeconds apart; a pair
  // keeps a status at least StatusCooldownSeconds.
  "ProposalSeconds": 60.0,
  "ProposalCooldownSeconds": 180.0,
  "StatusCooldownSeconds": 60.0,

  // What acts do to the observing god's view of the actor.
  "HelpGratitude": 0.08,
  "CourtingRivalry": 0.03,
  "HarmTrustLoss": 0.08,
  "HarmRivalry": 0.1,
  "BetrayalTrustLoss": 0.5,
  "BetrayalReputationLoss": 0.2,

  // War: a people resists the pull of its god's enemy by WarResistance where its god holds the majority,
  // and a Creature's urge to attack an enemy's settlement rises by WarCreatureAggression.
  "WarResistance": 0.6,
  "WarCreatureAggression": 0.6,

  // Pairs neither allied nor at war turn Friendly when both feel warmer than this, Hostile when either
  // feels colder than minus this.
  "HostilityThreshold": 0.35,

  // Treaties, favours and the Divine Council (spec sections 38-42 and 54, ADR-025). Times are in seconds.
  "Politics": {
    // Treaties last at most MaxTreatySeconds (0 holds until broken); a tribute pays at most MaxTribute Divine Power
    // a minute; a god may ask at most MaxPowerAsk Divine Power. Each secret treaty comes to light with
    // SecretLeakPerSecond chance a second. Breaking a treaty costs TreatyBetrayalShare of an alliance's betrayal.
    "MaxTreatySeconds": 1200.0,
    "MaxTribute": 60.0,
    "MaxPowerAsk": 500.0,
    "SecretLeakPerSecond": 0.002,
    "TreatyBetrayalShare": 0.6,

    // A god whose followers another saved in great need owes it a favour, up to MaxFavours. A promise of
    // assistance must be kept within AssistSeconds; a broken promise or a refused favour costs BrokenPromiseTrustLoss.
    "MaxFavours": 3.0,
    "AssistSeconds": 120.0,
    "BrokenPromiseTrustLoss": 0.2,

    // The council first sits after FirstCouncilSeconds, then every CouncilIntervalSeconds on a tabled motion;
    // betrayals, new dominance and disasters summon it, no sooner than CouncilCooldownSeconds after the last.
    // Votes stay open VoteSeconds; decrees hold DecreeSeconds.
    "FirstCouncilSeconds": 300.0,
    "CouncilIntervalSeconds": 300.0,
    "CouncilCooldownSeconds": 180.0,
    "VoteSeconds": 60.0,
    "DecreeSeconds": 480.0,

    // A condemned god loses CondemnTrustLoss of every god's trust and its followers gain CondemnDoubt; defying a
    // decree costs DefianceTrustLoss. Under a coordinated disaster response, help where disaster struck within
    // StruckSeconds costs CoordinatedCostFactor. Absorbing an ally turns AbsorbShare of its followers where the
    // absorbing god leads.
    "CondemnTrustLoss": 0.15,
    "CondemnDoubt": 0.08,
    "DefianceTrustLoss": 0.15,
    "CoordinatedCostFactor": 0.5,
    "StruckSeconds": 180.0,
    "AbsorbShare": 0.4
  },

  // War goals, intelligence, proxy wars and mortal holy wars (spec sections 43-46, ADR-026). Times are in seconds.
  "Conflict": {
    // War score for what a side wins from its enemy: villages converted, strikes on its followers (little, so
    // destruction is not the best road), its Creature defeated, its holy site taken, its people sheltered, holy-war
    // raids. A side may dictate peace with GoalScore and half as much lead (or its goal's site or Creature defeated).
    "ConversionScore": 3.0,
    "HarmScore": 0.5,
    "CreatureScore": 4.0,
    "SiteScore": 5.0,
    "RefugeeScore": 0.5,
    "RaidScore": 1.0,
    "GoalScore": 10.0,
    // Dictated peace: a tribute of DictatedTribute a minute, or a territorial agreement, for DictatedSeconds; a ceded
    // village turns CededShare of the loser's followers there.
    "DictatedTribute": 30.0,
    "DictatedSeconds": 600.0,
    "CededShare": 0.5,
    // What a god knows of another: an ally's share, a treaty's, its own followers among the other's people (per share),
    // its Creature's visits within ScoutSeconds, and a Knowledge god's learning. Capped at 1.
    "AllyIntel": 0.5,
    "TreatyIntel": 0.2,
    "PresenceIntel": 1.5,
    "ScoutIntel": 0.3,
    "ScoutSeconds": 180.0,
    "KnowledgeIntel": 0.3,
    // Veiled miracles cost VeilCostFactor; a covert act is exposed with ExposureChance at the wronged god's full
    // knowledge of its author (a quarter of it with none). A veiled strike plants VeiledDoubt in the people's own god.
    "VeilCostFactor": 2.0,
    "ExposureChance": 0.4,
    "VeiledDoubt": 0.03,
    // Proxy acts: inciting costs IncitePower and stirs InciteResentment (and half as much fear and unrest);
    // propaganda costs PropagandaPower and plants PropagandaDoubt. They need ProxyInfluence where they are done, and
    // ProxyCooldownSeconds between them.
    "IncitePower": 60.0,
    "InciteResentment": 0.2,
    "PropagandaPower": 40.0,
    "PropagandaDoubt": 0.1,
    "ProxyInfluence": 0.1,
    "ProxyCooldownSeconds": 240.0,
    // Holy wars: a settlement holding militarism from HolyWarMilitarism declares one with HolyWarPerSecond chance a
    // second (twice at war, scaled by its militarism); it lasts up to HolyWarSeconds (half if discouraged) and rests
    // HolyWarCooldownSeconds after. Raids kill and convert their shares a second at even strength. Discouraging costs
    // the attackers DiscourageLoveLoss of their love.
    "HolyWarMilitarism": 0.35,
    "HolyWarPerSecond": 0.01,
    "HolyWarSeconds": 240.0,
    "HolyWarCooldownSeconds": 600.0,
    "RaidDeathsPerSecond": 0.002,
    "RaidConversionPerSecond": 0.004,
    "DiscourageLoveLoss": 0.1
  },

  // Knowing the other gods (spec section 11, ADR-036). With MeetFirst, a god may ally with, war on, sign with or
  // ask of only the gods it has met. Gods meet when villages they lead lie within NeighbourMetres, when each is
  // followed by SharedAdherence of one village, when a whole road joins their villages, when their Creatures meet,
  // when one's deeds touch the other's people, and when they sit in the Divine Council.
  "Acquaintance": {
    "MeetFirst": true,
    "NeighbourMetres": 500.0,
    "SharedAdherence": 0.05
  }
}
