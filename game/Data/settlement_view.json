{
  // Presentation only: how settlements are drawn. The simulation never reads this file.
  // Distances are in metres.
  "Layout": {
    // Houses stand on a sunflower spiral around the shrine, one house per HousingPerHouse of
    // housing (settlement_rules.json). The house under construction takes the next slot.
    "ShrineClearance": 9.0,
    "HouseSpacing": 6.5,
    "MinimumGroundHeight": 0.6,
    "DoorDistance": 3.0,

    // Fields lie on a second spiral beyond the houses: one per HousesPerField houses, up to
    // MaxFields, on dry ground no steeper than FieldMaxSlope (rise over run).
    "HousesPerField": 3,
    "MaxFields": 48,
    "FieldSize": 10.0,
    "FieldSpacing": 9.0,
    "FieldClearance": 4.0,
    "FieldMaxSlope": 0.3,
    "CropColors": ["#c9a94e", "#a2b24c", "#6f9440", "#8b6b47"]
  },

  // Representative citizens (Tier 2, ADR-008): figures derived from the statistical state near
  // the camera, never saved. Each stands for population / count inhabitants.
  "Citizens": {
    "MaxRepresentatives": 300,
    "RegionalTierEnterDistance": 450.0,
    "RegionalTierExitDistance": 550.0,

    // Routine: sit by the door, walk to work, work, walk to the shrine, pray, walk home. It runs on
    // the crowds' own clock (ADR-049): with the game, but never more than PaceCap seconds of routine
    // a real second, so people walk at a human pace however fast the world runs, and stop when it
    // is paused. Rerouted citizens hurry to their new route at CatchUpSpeed (m/s).
    "WalkSpeed": 1.3,
    "CatchUpSpeed": 2.6,
    "PaceCap": 1.0,
    "RestSeconds": 50.0,
    "WorkSeconds": 110.0,
    "GatherSeconds": 30.0,

    // Spots: in front of the door, chores around home, a share of each field's side, a ring
    // around the building site and a ring around the shrine.
    "DoorSpread": 1.5,
    "WanderRadius": 8.0,
    "WorkSpread": 0.8,
    "BuilderRingRadius": 3.6,
    "GatherRadiusMin": 4.0,
    "GatherRadiusMax": 8.5,

    // Figures: a step of StrideLength metres with a gentle rise of StepBounce, a lean per work
    // stroke (radians), and a size a little above life so they read from the god's-eye view.
    "StrideLength": 0.8,
    "StepBounce": 0.035,
    "WorkLean": 0.4,
    "WorkStrokesPerSecond": 0.7,
    "FigureScale": 1.15,

    // Local navigation (spec section 85, ADR-046): figures find their way round huts, the shrine, the
    // temple and water on a grid of NavCellSize metres, keeping NavClearance metres from walls.
    "NavCellSize": 1.0,
    "NavClearance": 0.4,
    "FarmerColor": "#a8483a",
    "BuilderColor": "#e09a2a",
    "VillagerColor": "#4a6cb0"
  },

  // People (spec sections 61 and 80, ADR-049): each person's skin, hair, clothes, height and
  // headwear come from a hash of who they are. Clothes are by work: farmers in earth colours, builders
  // in greys and browns, everyone else in dyed linen. Some farmers wear straw hats and some builders
  // and villagers a scarf; some farmers and villagers a long dress. Beyond DetailDistance metres a
  // village's people use a simpler figure. Walking swings the legs LegSwing and the arms ArmSwing
  // radians each way.
  "People": {
    "SkinTones": ["#f3d5bc", "#e2b893", "#c99068", "#a06d47", "#74492c", "#4b2e1c"],
    "HairColors": ["#1c1511", "#3b2719", "#5e3c22", "#8f5f33", "#c9a66b", "#9a948c"],
    "FarmerClothes": ["#a08155", "#7f6c3e", "#9a5f3b", "#6e7346", "#b9a073", "#8a6a48"],
    "BuilderClothes": ["#7d736a", "#8f5d3e", "#5f5850", "#a6896b", "#6f4f3c"],
    "VillagerClothes": ["#5d7290", "#6f8b6c", "#d9d0ba", "#8c5c6c", "#4f6b7b", "#b07a4a", "#c9b48a"],
    "Trousers": "#4a3e31",
    "Straw": "#d8bd72",
    "Leather": "#3a2a1d",
    "Wood": "#8c6b46",
    "FarmerHatChance": 0.6,
    "BuilderScarfChance": 0.35,
    "VillagerScarfChance": 0.3,
    "DressChance": 0.4,
    "MinHeight": 0.9,
    "MaxHeight": 1.07,
    "DetailDistance": 170.0,
    "LegSwing": 0.42,
    "ArmSwing": 0.36
  },

  // Architecture (spec section 61, ADR-052): how villages build. The land picks the style: adobe
  // in the desert, stilt houses in the swamp, stone cottages in the highlands and on volcanic land,
  // timber longhouses in forests and the tundra, and round huts elsewhere until a village has
  // LonghouseHouses houses. At TwoStoreyHouses houses they build a second storey. A village picks
  // one of its style's wall and roof colours, and each house varies by HouseVariation. Where the
  // god most of a village follows shows at least MotifStrength (see Style), the houses take its
  // colours: turf roofs for nature and growth, dark timber and roofs for war and death, whitewash
  // and blue for learning.
  "Architecture": {
    "Styles": {
      "RoundHut": { "Walls": ["#b8a07c", "#a88f6c", "#c2ab88"], "Roofs": ["#c9a24f", "#b8913f", "#d1ad5e"] },
      "Longhouse": { "Walls": ["#8d6d4a", "#7c5e40", "#9a7a55"], "Roofs": ["#b8954a", "#a2833f", "#c4a35a"] },
      "StoneCottage": { "Walls": ["#9d988f", "#8c877e", "#a8a296"], "Roofs": ["#4f5661", "#5c4b44", "#3f4752"] },
      "Adobe": { "Walls": ["#d9b98a", "#cfa877", "#e2c59a"], "Roofs": ["#c9a678", "#bf9a6a"] },
      "StiltHouse": { "Walls": ["#7d6347", "#6c543b", "#8a6f50"], "Roofs": ["#a8904a", "#93803f"] }
    },
    "Trim": "#4a3624",
    "Door": "#3b2a1c",
    "Window": "#1d1b19",
    "Stone": "#807a71",
    "GardenRoof": "#5d7a39",
    "MonumentRoof": "#3d2626",
    "MonumentWall": "#4a3a33",
    "LoreWall": "#ebe5d7",
    "LoreRoof": "#4b6a8c",
    "MotifStrength": 0.35,
    "LonghouseHouses": 18,
    "TwoStoreyHouses": 40,
    "HouseVariation": 0.08
  },

  // Trees (spec sections 61 and 93, ADR-053): the species each biome grows and their shares (a biome
  // not listed grows Grassland's), each species' trunk and leaves, and how far a tree's top sways:
  // Sway metres in a light breeze, and StormSway more in the strongest wind of the weather.
  "Trees": {
    "Species": {
      "Grassland": { "Oak": 0.65, "Birch": 0.25, "Pine": 0.1 },
      "Forest": { "Pine": 0.35, "Oak": 0.35, "Birch": 0.3 },
      "Highland": { "Fir": 0.6, "Pine": 0.3, "Birch": 0.1 },
      "Tundra": { "Fir": 0.8, "Birch": 0.2 },
      "RiverValley": { "Willow": 0.4, "Oak": 0.4, "Birch": 0.2 },
      "Swamp": { "Willow": 0.7, "Snag": 0.3 },
      "Coast": { "Pine": 0.4, "Oak": 0.4, "Palm": 0.2 },
      "Island": { "Palm": 0.7, "Oak": 0.3 },
      "Desert": { "Palm": 0.6, "Snag": 0.4 },
      "Volcanic": { "Snag": 0.6, "Pine": 0.4 }
    },
    "Colors": {
      "Pine": { "Trunk": "#5a4130", "Leaves": "#2f5a32" },
      "Fir": { "Trunk": "#4e3a2c", "Leaves": "#26492f" },
      "Oak": { "Trunk": "#5c4632", "Leaves": "#4d7a34" },
      "Birch": { "Trunk": "#d8d2c4", "Leaves": "#7aa23e" },
      "Palm": { "Trunk": "#8a6e4a", "Leaves": "#4f8a3a" },
      "Willow": { "Trunk": "#5a4a36", "Leaves": "#6f9a48" },
      "Snag": { "Trunk": "#4a423c", "Leaves": "#4a423c" }
    },
    "Sway": 0.15,
    "StormSway": 0.9
  },

  // Ground cover (spec section 61, ADR-053): within Radius metres of the camera, in chunks of
  // ChunkMetres, each cell of CellMetres may hold one thing, by its biome's chances: grass and
  // flowers as thick as the land's vegetation, bushes, stones and reeds. Nothing grows in water, on
  // bare rock, in a village's clearing or on a road; snow pales it. A biome not listed is bare.
  "GroundCover": {
    "CellMetres": 1.2,
    "ChunkMetres": 32.0,
    "Radius": 100.0,
    "Biomes": {
      "Grassland": { "Grass": 0.7, "Flowers": 0.07, "Bush": 0.025, "Rock": 0.01 },
      "RiverValley": { "Grass": 0.75, "Flowers": 0.08, "Bush": 0.02, "Rock": 0.005 },
      "Coast": { "Grass": 0.55, "Flowers": 0.04, "Bush": 0.02, "Rock": 0.02 },
      "Island": { "Grass": 0.6, "Flowers": 0.06, "Bush": 0.03, "Rock": 0.015 },
      "Forest": { "Grass": 0.3, "Flowers": 0.02, "Bush": 0.12, "Rock": 0.03 },
      "Highland": { "Grass": 0.3, "Bush": 0.02, "Rock": 0.08 },
      "Tundra": { "Grass": 0.2, "Rock": 0.08 },
      "Swamp": { "Grass": 0.2, "Reeds": 0.35, "Bush": 0.03 },
      "Desert": { "Grass": 0.04, "Bush": 0.04, "Rock": 0.05 },
      "Volcanic": { "Rock": 0.1, "Grass": 0.05 }
    },
    "Grass": ["#5f8f38", "#6c9a3e", "#7aa546", "#8eb052"],
    "DryGrass": "#b39a5c",
    "Petals": ["#f2d14c", "#ffffff", "#d96a8a", "#9b7ad9", "#e8893a"],
    "Bush": "#3f6a2c",
    "Stone": "#8a857c",
    "Reeds": "#7f8a4a"
  },

  // Religion's look (spec section 61, ADR-042). The god most of a village follows gives it a motif:
  // gardens (Nature, Life, Prosperity, Ocean; compassion, mercy, generosity; nature worship,
  // pacifism, charity; love), monuments (War, Death, Fire, Storm, Chaos; cruelty, vengeance,
  // ambition, chaos; militarism, sacrifice, expansionism; fear) or lore (Knowledge, Justice,
  // Protection, Trickery; honesty, deceit; knowledge seeking, isolationism; faith). A motif's score
  // weighs these, and shows from Threshold times the god's share, with up to MaxPieces pieces.
  "Style": {
    "DomainWeight": 0.4,
    "DoctrineWeight": 0.3,
    "TraitWeight": 0.15,
    "FeelingWeight": 0.15,
    "Threshold": 0.12,
    "MaxPieces": 14,
    "ShrineRingRadius": 5.0,
    "GardenSpacing": 3.2,
    "HouseClearance": 3.0,
    "FlowerColors": ["#e86a7a", "#f2c94c", "#b07ad9", "#f29e4c", "#ffffff"],
    "Bush": "#3d7a34",
    "Obelisk": "#2e2a30",
    "Flame": "#ff8a2a",
    "Column": "#ece6da"
  },

  // Debris (spec sections 94 and 55, ADR-048): when the simulation brings a house down, HousePlanks
  // planks, HouseStones stones and HouseShards shards of thatch fly off; a thrown thing or a falling
  // star throws up StrikeStones stones. Pieces fly out at up to Impulse m/s and up at Lift m/s,
  // spinning up to Spin rad/s, land on a patch of ground GroundPatch metres across, and last Lifetime
  // seconds, fading over the last FadeSeconds; at most MaxBodies at once, and none further than Reach
  // metres from the camera.
  "Debris": {
    "Lifetime": 9.0,
    "FadeSeconds": 2.0,
    "MaxBodies": 240,
    "HousePlanks": 6,
    "HouseStones": 4,
    "HouseShards": 3,
    "StrikeStones": 7,
    "Impulse": 5.0,
    "Lift": 5.0,
    "Spin": 6.0,
    "Reach": 700.0,
    "GroundPatch": 28.0,
    "Wood": "#8a6440",
    "Stone": "#8f8a82",
    "Thatch": "#c9a24f"
  },

  // World streaming (spec section 84, ADR-050): the land near the camera carries its detail, and
  // the rest stays simulation data. Forests are planted in 256 m chunks within ForestLoadRadius of
  // the camera, a few chunks a frame, and cleared beyond ForestUnloadRadius; the fallback terrain is
  // drawn in full detail within TerrainDetailRadius and coarse again beyond TerrainCoarseRadius;
  // fires are drawn within EffectRadius. Distances are measured from the camera itself, so a high
  // camera loads only what it could see. Terrain3D brings its own detail by distance.
  "Streaming": {
    "ForestLoadRadius": 2100.0,
    "ForestUnloadRadius": 2500.0,
    "ForestChunksPerFrame": 6,
    "TerrainDetailRadius": 650.0,
    "TerrainCoarseRadius": 850.0,
    "TerrainChunksPerFrame": 1,
    "EffectRadius": 2500.0
  }
}
