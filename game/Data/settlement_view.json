{
  // Presentation only: how settlements are drawn. The simulation never reads this file.
  // Distances are in metres.
  "Layout": {
    // Houses stand on a sunflower spiral around the shrine, one house per HousingPerHouse of
    // housing (settlement_rules.json). The house under construction takes the next slot.
    "ShrineClearance": 9.0,
    "HouseSpacing": 6.5,
    "MinimumGroundHeight": 0.6,
    "DoorDistance": 3.0,

    // Fields lie on a second spiral beyond the houses: one per HousesPerField houses, up to
    // MaxFields, on dry ground no steeper than FieldMaxSlope (rise over run).
    "HousesPerField": 3,
    "MaxFields": 48,
    "FieldSize": 10.0,
    "FieldSpacing": 9.0,
    "FieldClearance": 4.0,
    "FieldMaxSlope": 0.3,
    "CropColors": ["#c9a94e", "#a2b24c", "#6f9440", "#8b6b47"]
  },

  // Representative citizens (Tier 2, ADR-008): figures derived from the statistical state near
  // the camera, never saved. Each stands for population / count inhabitants.
  "Citizens": {
    "MaxRepresentatives": 300,
    "RegionalTierEnterDistance": 450.0,
    "RegionalTierExitDistance": 550.0,

    // Routine: sit by the door, walk to work, work, walk to the shrine, pray, walk home. It runs on
    // the crowds' own clock (ADR-049): with the game, but never more than PaceCap seconds of routine
    // a real second, so people walk at a human pace however fast the world runs, and stop when it
    // is paused. Rerouted citizens hurry to their new route at CatchUpSpeed (m/s).
    "WalkSpeed": 1.3,
    "CatchUpSpeed": 2.6,
    "PaceCap": 1.0,
    "RestSeconds": 50.0,
    "WorkSeconds": 110.0,
    "GatherSeconds": 30.0,

    // Spots: in front of the door, chores around home, a share of each field's side, a ring
    // around the building site and a ring around the shrine.
    "DoorSpread": 1.5,
    "WanderRadius": 8.0,
    "WorkSpread": 0.8,
    "BuilderRingRadius": 3.6,
    "GatherRadiusMin": 4.0,
    "GatherRadiusMax": 8.5,

    // Figures: a step of StrideLength metres with a gentle rise of StepBounce, a lean per work
    // stroke (radians), and a size a little above life so they read from the god's-eye view.
    "StrideLength": 0.8,
    "StepBounce": 0.035,
    "WorkLean": 0.4,
    "WorkStrokesPerSecond": 0.7,
    "FigureScale": 1.15,

    // Local navigation (spec section 85, ADR-046): figures find their way round huts, the shrine, the
    // temple and water on a grid of NavCellSize metres, keeping NavClearance metres from walls.
    "NavCellSize": 1.0,
    "NavClearance": 0.4,
    "FarmerColor": "#a8483a",
    "BuilderColor": "#e09a2a",
    "VillagerColor": "#4a6cb0"
  },

  // People (spec sections 61 and 80, ADR-049): each person's skin, hair, clothes, height and
  // headwear come from a hash of who they are. Clothes are by work: farmers in earth colours, builders
  // in greys and browns, everyone else in dyed linen. Some farmers wear straw hats and some builders
  // and villagers a scarf; some farmers and villagers a long dress. Beyond DetailDistance metres a
  // village's people use a simpler figure. Walking swings the legs LegSwing and the arms ArmSwing
  // radians each way.
  "People": {
    "SkinTones": ["#f3d5bc", "#e2b893", "#c99068", "#a06d47", "#74492c", "#4b2e1c"],
    "HairColors": ["#1c1511", "#3b2719", "#5e3c22", "#8f5f33", "#c9a66b", "#9a948c"],
    "FarmerClothes": ["#a08155", "#7f6c3e", "#9a5f3b", "#6e7346", "#b9a073", "#8a6a48"],
    "BuilderClothes": ["#7d736a", "#8f5d3e", "#5f5850", "#a6896b", "#6f4f3c"],
    "VillagerClothes": ["#5d7290", "#6f8b6c", "#d9d0ba", "#8c5c6c", "#4f6b7b", "#b07a4a", "#c9b48a"],
    "Trousers": "#4a3e31",
    "Straw": "#d8bd72",
    "Leather": "#3a2a1d",
    "Wood": "#8c6b46",
    "FarmerHatChance": 0.6,
    "BuilderScarfChance": 0.35,
    "VillagerScarfChance": 0.3,
    "DressChance": 0.4,
    "MinHeight": 0.9,
    "MaxHeight": 1.07,
    "DetailDistance": 170.0,
    "LegSwing": 0.42,
    "ArmSwing": 0.36
  },

  // Religion's look (spec section 61, ADR-042). The god most of a village follows gives it a motif:
  // gardens (Nature, Life, Prosperity, Ocean; compassion, mercy, generosity; nature worship,
  // pacifism, charity; love), monuments (War, Death, Fire, Storm, Chaos; cruelty, vengeance,
  // ambition, chaos; militarism, sacrifice, expansionism; fear) or lore (Knowledge, Justice,
  // Protection, Trickery; honesty, deceit; knowledge seeking, isolationism; faith). A motif's score
  // weighs these, and shows from Threshold times the god's share, with up to MaxPieces pieces.
  "Style": {
    "DomainWeight": 0.4,
    "DoctrineWeight": 0.3,
    "TraitWeight": 0.15,
    "FeelingWeight": 0.15,
    "Threshold": 0.12,
    "MaxPieces": 14,
    "ShrineRingRadius": 5.0,
    "GardenSpacing": 3.2,
    "HouseClearance": 3.0,
    "FlowerColors": ["#e86a7a", "#f2c94c", "#b07ad9", "#f29e4c", "#ffffff"],
    "Bush": "#3d7a34",
    "Obelisk": "#2e2a30",
    "Flame": "#ff8a2a",
    "Column": "#ece6da"
  },

  // Debris (spec sections 94 and 55, ADR-048): when the simulation brings a house down, HousePlanks
  // planks, HouseStones stones and HouseShards shards of thatch fly off; a thrown thing or a falling
  // star throws up StrikeStones stones. Pieces fly out at up to Impulse m/s and up at Lift m/s,
  // spinning up to Spin rad/s, land on a patch of ground GroundPatch metres across, and last Lifetime
  // seconds, fading over the last FadeSeconds; at most MaxBodies at once, and none further than Reach
  // metres from the camera.
  "Debris": {
    "Lifetime": 9.0,
    "FadeSeconds": 2.0,
    "MaxBodies": 240,
    "HousePlanks": 6,
    "HouseStones": 4,
    "HouseShards": 3,
    "StrikeStones": 7,
    "Impulse": 5.0,
    "Lift": 5.0,
    "Spin": 6.0,
    "Reach": 700.0,
    "GroundPatch": 28.0,
    "Wood": "#8a6440",
    "Stone": "#8f8a82",
    "Thatch": "#c9a24f"
  }
}
