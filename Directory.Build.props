<Project>
  <!-- Shared settings for every C# project, including the Godot project in game/. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!--
      Exhaustive enum switches: switch expressions over enums list every member and no discard arm,
      so adding a member fails the build (CS8509). CS8524 only concerns unnamed numeric values,
      which already throw SwitchExpressionException at runtime.
    -->
    <NoWarn>$(NoWarn);CS8524</NoWarn>
  </PropertyGroup>
</Project>
