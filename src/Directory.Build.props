<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Engine-agnostic libraries: public APIs must be documented. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Pantheon.Tests'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Godot exports build referenced projects with its ExportRelease configuration. -->
  <PropertyGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
